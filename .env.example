# ── Printique environment ─────────────────────────────────────────────
# Copy to .env.local for development. NEVER commit real secrets.

# Data directory for the SQLite database and uploaded files.
DATA_DIR=./.data

# Public site URL (used for SEO, emails, OAuth-less flows)
SITE_URL=http://localhost:3000

# Secret used to HMAC-sign mock-payment webhooks and password-reset URLs.
# Generate with: openssl rand -hex 32
APP_SECRET=change-me-in-production-0123456789abcdef

# ── Payments ───────────────────────────────────────────────────────────
# PAYMENT_PROVIDER=mock | stripe
PAYMENT_PROVIDER=mock
# Stripe (only when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email ──────────────────────────────────────────────────────────────
# EMAIL_PROVIDER=console | smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Printique <hello@printique.example>

# ── AI ─────────────────────────────────────────────────────────────────
# AI_PROVIDER=none | openai-compatible
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Hard monthly guardrail: max assistant requests per IP/hour
AI_RATE_LIMIT=30

# ── Commerce ───────────────────────────────────────────────────────────
# Sales tax applied at checkout (0.08 = 8%). Configure per deployment.
TAX_RATE=0.08
# Flat shipping in cents; orders above FREE_SHIPPING_THRESHOLD_CENTS ship free.
SHIPPING_FLAT_CENTS=999
FREE_SHIPPING_THRESHOLD_CENTS=10000
CURRENCY=USD
